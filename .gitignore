# Dependencias (cada app instala las suyas)
node_modules/

# Next.js / builds
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Entorno
.env*
!.env.example

# Credenciales locales de la API
services/api/auth.json

# Sistema / logs
.DS_Store
npm-debug.log*

# Datos locales del gestor de incidencias (se regeneran con scripts/seed_incidents.py)
services/api/incidents.json

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Cobertura de pytest
.coverage
htmlcov/

# Salidas locales del pipeline semanal: resultados persistidos de Prefect y snapshots de eval por corrida
data/raw/weekly_warehouse_client_performance/
data/eval/weekly_warehouse_client_performance/

# Backups CSV del job nocturno (telemetría con user_id y session_id: no se versionan)
data/raw/telemetry_*.csv
data/raw/.telemetry_*.csv.partial

# Traces de cada corrida del agente LangGraph (los de los evals viven en data/eval/agent/traces/)
data/raw/agent_traces/
