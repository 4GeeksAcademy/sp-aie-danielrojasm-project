JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PASSWORD_RESET_URL=
DATABASE_URL=
# Telemetría: URL de la ingesta de eventos (hoy, el receptor de esta API).
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
TELEMETRY_ENVIRONMENT=development
# Clave del HMAC de los emails en eventos de login (fuera del almacén de eventos).
TELEMETRY_HASH_KEY=
# Mínimo de stock por cliente (client_id → unidades); sin entrada, 50.
STOCK_MIN_THRESHOLDS=
# Backoffice: next.config.ts carga solo estas NEXT_PUBLIC_TELEMETRY_* de este archivo.
# En Codespaces, /api/telemetry/events (el navegador no llega al puerto 8000).
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
NEXT_PUBLIC_TELEMETRY_ENVIRONMENT=development
# Docker Compose: URLs entre servicios por nombre de servicio, nunca localhost
TRACKFLOW_API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_INVENTORY_API_URL=http://api:8000
# Docker Compose: URLs del navegador hacia el backoffice del contenedor (:3001)
DOCKER_BACKOFFICE_ORIGIN=http://localhost:3001
DOCKER_PASSWORD_RESET_URL=http://localhost:3001/reset-password
# Cola de tareas (Celery): Redis es broker y result backend. En local, el Redis
# de `docker compose up redis` (127.0.0.1: en Windows, `localhost` prueba antes IPv6
# y tarda ~2 s en conectar); dentro de Compose, por nombre de servicio.
REDIS_URL=redis://127.0.0.1:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0
# Base del backoff exponencial de los reintentos (base × 2^n: 30, 60, 120 s).
TASKS_RETRY_BACKOFF_SECONDS=30
# Solo para demos: el pipeline falla siempre para mostrar reintentos y DLQ. Nunca en producción.
TASKS_SIMULATE_FAILURE=
